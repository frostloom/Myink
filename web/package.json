{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:vue && vite build",
    "lint": "npm run lint:shared && npm run lint:vue",
    "test": "npm run test:shared && npm run test:vue",
    "preview": "vite preview",
    "dev:vue": "vite --config vite.vue.config.ts",
    "build:vue": "npm run build",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json && tsc --noEmit -p tsconfig.vue.node.json",
    "test:vue": "vitest run --config vitest.vue.config.ts",
    "lint:vue": "eslint --config eslint.vue.config.mjs vue/src && oxlint vue/src vite.config.ts vite.vue.config.ts vitest.vue.config.ts vitest.shared.config.ts",
    "lint:shared": "oxlint src/lib src/types.ts",
    "test:shared": "vitest run --config vitest.shared.config.ts",
    "test:browser:vue": "node scripts/vue-browser-smoke.mjs",
    "test:browser:matrix": "node scripts/browser-matrix.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@testing-library/vue": "8.1.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.75.0",
    "playwright": "1.64.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  }
}
