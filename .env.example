# Ai Ink 环境配置样例 —— 复制为 .env 后填写（.env 不入 git，密钥不进代码库，plan §17.2）
# 环境分层：dev / test / prod（config.py 读取，默认 dev）

APP_ENV=dev

# 应用连接：非超级 + NOBYPASSRLS（受 RLS 约束，§14.1 坑：超级用户永远绕过 RLS）
DATABASE_URL=postgresql+psycopg://aiink_app:aiink@localhost:5432/aiink
# DDL/迁移连接：表 owner 超级用户（仅 init/迁移/RLS 用，业务不碰）
ADMIN_DATABASE_URL=postgresql+psycopg://aiink:aiink@localhost:5432/aiink

# DeepSeek API（主模型，plan §19.3：v4-flash 默认 / v4-pro 备选）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 自定义网络模型 API Key 的落库加密主密钥；部署后请保持不变。
MODEL_CREDENTIAL_KEY=

# 日志级别
LOG_LEVEL=INFO

# 阶段 2：Redis（§阶段2；自建 aiink-redis 容器，6380 端口避开外部 rag-redis 的 6379。
# 队列职责阶段 6 迁 RabbitMQ，Redis 保留 SSE 进度流 / 锁 / 三层闸门 / worker 心跳）
REDIS_URL=redis://localhost:6380/0

# 阶段 6：RabbitMQ 任务队列（替代 Redis Streams 主队列 + ZSET 延迟 + 网关 dispatcher）。
# 本机程序连接 compose RabbitMQ 使用 aiink/aiink；容器内主机名为 aiink-rabbitmq
AMQP_URL=amqp://aiink:aiink@localhost:5672/
# 队列/交换名前缀（仅测试隔离用，生产留空与 Go/Python 端拓扑名一致）
QUEUE_PREFIX=
# VIP 优先级：JWT tier=vip 的消息 priority 属性（主队列 x-max-priority=10）
PRIORITY_VIP=9
PRIORITY_NORMAL=0

# 阶段 2 展示前端：网关唯一入口（app.py 生成走网关异步，§17.2）
GATEWAY_URL=http://localhost:8080

# 阶段 2 三层闸门配额（§13）：每用户每日总量 / 每书每日章节数 / 每天最多碰几本不同书 / 日成本预算（¥）
# 默认 QUOTA_DAILY_CHAPTERS=2 太紧（多书演示很快撞满）；本地演示放宽到 500 / 每书50 / 每天10本书
QUOTA_DAILY_CHAPTERS=500
BOOK_QUOTA_DAILY_CHAPTERS=50
BOOKS_PER_DAY=10
DAILY_BUDGET_YUAN=2.0

# 阶段 3：JWT 身份断言（§14.1 ③，替换 X-AiInk-User 占位）。
# HS256 签名密钥：Python（config.py 签发）与 Go 网关（middleware.go 验签）共享同一 .env。
# 本地 dev 不填则两端共用非空默认值（可跑通）；生产必须显式设置（APP_ENV=prod 时默认值被拒）。
# 换用强随机值：openssl rand -base64 48
JWT_SECRET=

# 阶段 5 扫榜灵感（§10）：MCP Client 拉取起点外部榜单（DaoSearch Streamable HTTP 端点）。
# 榜单只作建书前的题材风向灵感工具、不进记忆/事实层、不注入任何生成节点；默认开，
# 网络不可达自动降级内置示例数据。RANKINGS_ENABLED=0 关闭；RANKINGS_TOOL 留空自动发现。
RANKINGS_ENABLED=1
RANKINGS_MCP_URL=https://daosearch.io/api/mcp
RANKINGS_TIMEOUT=10
RANKINGS_LIMIT=10
RANKINGS_CACHE_TTL=3600
RANKINGS_SOURCE=qidian
RANKINGS_TOOL=

# 章节提示词估算预算（中文字符启发式，非精确 tokenizer 计数）。
# 组装预留 1000 给工具描述/纠错；完整章节请求（含工具结果）也会检查。
RECALL_TOKEN_BUDGET=12000

# 完整模型请求预算（正文/硬约束/提示词/工具），与召回记忆预算分开
REQUEST_TOKEN_BUDGET=64000
