# Ai Ink 环境配置样例 —— 复制为 .env 后填写（.env 不入 git，密钥不进代码库，plan §17.2）
# 环境分层：dev / test / prod（config.py 读取，默认 dev）

APP_ENV=dev

# 应用连接：非超级 + NOBYPASSRLS（受 RLS 约束，§14.1 坑：超级用户永远绕过 RLS）
DATABASE_URL=postgresql+psycopg://aiink_app:aiink@localhost:5432/aiink
# DDL/迁移连接：表 owner 超级用户（仅 init/迁移/RLS 用，业务不碰）
ADMIN_DATABASE_URL=postgresql+psycopg://aiink:aiink@localhost:5432/aiink

# DeepSeek API（主模型，plan §19.3：v4-flash 默认 / v4-pro 备选）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 日志级别
LOG_LEVEL=INFO

# 阶段 2：Redis 队列（§阶段2；自建 aiink-redis 容器，6380 端口避开外部 rag-redis 的 6379）
REDIS_URL=redis://localhost:6380/0

# 阶段 2 展示前端：网关唯一入口（app.py 生成走网关异步，§17.2）
GATEWAY_URL=http://localhost:8080

# 阶段 2 三层闸门配额（§13）：每用户每日总量 / 每书每日章节数 / 每天最多碰几本不同书 / 日成本预算（¥）
# 默认 QUOTA_DAILY_CHAPTERS=2 太紧（多书演示很快撞满）；本地演示放宽到 500 / 每书50 / 每天10本书
QUOTA_DAILY_CHAPTERS=500
BOOK_QUOTA_DAILY_CHAPTERS=50
BOOKS_PER_DAY=10
DAILY_BUDGET_YUAN=2.0
