# Myink 环境配置样例 —— 复制为 .env 后填写（.env 不入 git，密钥不进代码库，plan §17.2）
# 环境分层：dev / test / prod（config.py 读取，默认 dev）

APP_ENV=dev

# 应用连接：非超级 + NOBYPASSRLS（受 RLS 约束，§14.1 坑：超级用户永远绕过 RLS）
DATABASE_URL=postgresql+psycopg://myink_app:myink@localhost:5432/myink
# DDL/迁移连接：表 owner 超级用户（仅 init/迁移/RLS 用，业务不碰）
ADMIN_DATABASE_URL=postgresql+psycopg://myink:myink@localhost:5432/myink

# 模型 API Key 只在前端「环境配置」填写，不写进本文件。
# 落库加密主密钥（加密用户自己的 Key）；部署后请保持不变。未填则从 JWT_SECRET 派生。
MODEL_CREDENTIAL_KEY=

# 日志级别
LOG_LEVEL=INFO

# 阶段 2：Redis（§阶段2；自建 myink-redis 容器，6380 端口避开外部 rag-redis 的 6379。
# 队列职责阶段 6 迁 RabbitMQ，Redis 保留 SSE 进度流 / 锁 / 三层闸门 / worker 心跳）
REDIS_URL=redis://localhost:6380/0

# 阶段 6：RabbitMQ 任务队列（替代 Redis Streams 主队列 + ZSET 延迟 + 网关 dispatcher）。
# 本机程序连接 compose RabbitMQ 使用 myink/myink；容器内主机名为 myink-rabbitmq
AMQP_URL=amqp://myink:myink@localhost:5672/
# 队列/交换名前缀（仅测试隔离用，生产留空与 Go/Python 端拓扑名一致）
QUEUE_PREFIX=
# VIP 优先级：JWT tier=vip 的消息 priority 属性（主队列 x-max-priority=10）
PRIORITY_VIP=9
PRIORITY_NORMAL=0

# 阶段 2 三层闸门配额（§13）：每用户每日总量 / 每书每日章节数 / 每天最多碰几本不同书 / 日成本预算（¥）
# 默认 QUOTA_DAILY_CHAPTERS=2 太紧（多书演示很快撞满）；本地演示放宽到 500 / 每书50 / 每天10本书
QUOTA_DAILY_CHAPTERS=500
BOOK_QUOTA_DAILY_CHAPTERS=50
BOOKS_PER_DAY=10
DAILY_BUDGET_YUAN=2.0

# 阶段 3：JWT 身份断言（§14.1 ③，替换 X-Myink-User 占位）。
# HS256 签名密钥：签发与验签都在 myink-api（config.py / auth.py），单一进程内闭环。
# 所有环境都必须显式配置至少 32 字节的强随机密钥，否则注册/登录拒绝服务。
# 已有模型密钥且 MODEL_CREDENTIAL_KEY 为空时，更换 JWT_SECRET 前先将旧有效 JWT_SECRET
# 固定到 MODEL_CREDENTIAL_KEY，保留旧密文解密能力。详见 docs/AUTH.md；不要覆盖已有 .env。
# 另：邀请码只存 HMAC(JWT_SECRET, 码面) 摘要，换密钥会让库中所有未用尽的邀请码失效。
# 换用强随机值：openssl rand -base64 48
JWT_SECRET=

# 进程内令牌桶（粗粒度 DoS 盾，非业务配额；真正的配额是上面的三层闸门）：
# 每秒补充 token 数 / 桶容量。全局一个桶，在 myink-api 进程内——SSE 与其余路由同源，
# 不再有「两个进程各一份桶、限额相加」那回事。
RATE_PER_SEC=20
RATE_BURST=40

# 客户端 IP：边缘（caddy/Caddyfile）用 `header_up X-Myink-Client-IP {http.request.remote.host}`
# 覆盖写入，Python 只认这个头（读不到才回落到直连对端地址）。header_up 是「设置」不是「追加」，
# 客户端自带的同名头会被抹掉，所以伪造这个头不能自选限流桶。
# ⚠️ 将来若在 Caddy 前面再挂一层（CDN / 云 LB），那一层必须配 Caddy 全局 `trusted_proxies`
# 并把这里换成 `{client_ip}`；否则拿到的全是那层的 IP，所有用户塌进同一个桶——一个人刷就
# 锁死所有人登录（24057ae 修掉的正是这个故障）。不要改成在 Python 侧加环境变量来绕。

# 边缘层站点地址（compose 拿它插值给 Caddy，见 caddy/Caddyfile 顶部）。
# http://localhost = 本地纯 HTTP（默认） / localhost = 本地自签 HTTPS / 域名（不带协议）= 生产 ACME 自动签发续期。
# 换成域名时 web/vite.config.ts 的 dev proxy 目标也要一起改。切流步骤见 docs/DEPLOY.md。
SITE_ADDRESS=http://localhost

# 扫榜表单初值（用户可在前端「环境配置」覆盖；未保存时才读这里）。
# 榜单只作建书前灵感、不进记忆层。RANKINGS_CACHE_TTL 仍只走进程配置。
RANKINGS_ENABLED=1
RANKINGS_MCP_URL=https://daosearch.io/api/mcp
RANKINGS_TIMEOUT=10
RANKINGS_LIMIT=10
RANKINGS_CACHE_TTL=3600
RANKINGS_SOURCE=qidian
RANKINGS_TOOL=

# 章节提示词估算预算（中文字符启发式，非精确 tokenizer 计数）。
# 组装预留 1000 给工具描述/纠错；完整章节请求（含工具结果）也会检查。
RECALL_TOKEN_BUDGET=12000

# 完整模型请求预算（正文/硬约束/提示词/工具），与召回记忆预算分开
REQUEST_TOKEN_BUDGET=64000
