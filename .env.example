# Myink 环境配置样例 —— 复制为 .env 后填写（.env 不入 git，密钥不进代码库，plan §17.2）
# 环境分层：dev / test / prod（config.py 读取，默认 dev）
#
# ⚠️ 公网部署必须改的四处（详见 docs/DEPLOY.md 与 docs/PUBLIC-DEPLOYMENT-CHECKLIST.md）：
#   1. APP_ENV=prod —— 只有 prod 才会拒绝 dev 默认 JWT 密钥、收紧校验；
#   2. JWT_SECRET 填强随机值（openssl rand -base64 48），空值会让注册/登录直接拒绝服务；
#   3. 下面「基础设施口令」四项全部换成强随机值 —— compose 默认值与本文档一致，
#      不改就等于用公开默认口令上线。
#   4. SITE_ADDRESS 填域名（不带协议前缀）—— 保持默认值时 Caddy 只认 localhost，
#      换成域名访问会拿到 200 空页（不报错），在手机上就是一片空白，见下面「边缘层站点地址」。

# 公网上线必须改成 prod：dev 会接受 dev 默认 JWT 密钥，并放宽校验。
APP_ENV=dev

# 应用连接：非超级 + NOBYPASSRLS（受 RLS 约束，§14.1 坑：超级用户永远绕过 RLS）
DATABASE_URL=postgresql+psycopg://myink_app:myink@localhost:5432/myink
# 特权连接：本机开发直接用表 owner 超级用户（本机要跑 `myink init`）；生产由 compose 按容器
# 分岔——myink-migrate 用超级用户建表，myink-api 用只读报表角色 myink_report，myink-worker
# 不注入。表 owner 串不要再进长期运行的容器，见 docs/DEPLOY.md「数据库最小权限」。
ADMIN_DATABASE_URL=postgresql+psycopg://myink:myink@localhost:5432/myink

# ---- 基础设施口令（docker compose 插值用；Python 本身不读这几个名字）----
# compose 里所有口令都写成 ${XXX:-默认值}，默认值就是本地开发用的 myink。
# 公网部署务必逐项改成强随机值：不改则以公开默认口令运行（本机其它进程可直接连库/连队列）。
# 只有 PostgreSQL 的口令受「首启生效」限制——数据卷已初始化过就不会再改，改口令要连卷一起重建
# 或手工 ALTER ROLE；RabbitMQ 同理（RABBITMQ_DEFAULT_* 只对全新卷生效）。
# ⚠️ 口令请用 URL 安全字符（字母数字，别用 @ : / ? #），它们会被拼进 DATABASE_URL/REDIS_URL。
# POSTGRES_PASSWORD=myink                # postgres 超级用户（库 owner）
# MYINK_APP_PASSWORD=myink               # 业务角色 myink_app（NOBYPASSRLS）
# MYINK_REPORT_PASSWORD=myink            # 只读报表角色 myink_report（BYPASSRLS + 仅 SELECT）
# REDIS_PASSWORD=myink                   # redis requirepass
# RABBITMQ_PASSWORD=myink                # RabbitMQ myink 用户

# 模型 API Key 只在前端「环境配置」填写，不写进本文件。
# 落库加密主密钥（加密用户自己的 Key）；部署后请保持不变。未填则从 JWT_SECRET 派生。
MODEL_CREDENTIAL_KEY=

# 可选自部署说明地址，仅模型连接失败时展示。
SELF_HOST_URL=

# 日志级别
LOG_LEVEL=INFO

# 阶段 2：Redis（§阶段2；自建 myink-redis 容器，6380 端口避开外部 rag-redis 的 6379。
# 队列职责阶段 6 迁 RabbitMQ，Redis 保留 SSE 进度流 / 锁 / 三层闸门 / worker 心跳）
REDIS_URL=redis://localhost:6380/0

# 阶段 6：RabbitMQ 任务队列（替代 Redis Streams 主队列 + ZSET 延迟 + 网关 dispatcher）。
# 本机程序连接 compose RabbitMQ 使用 myink/myink；容器内主机名为 myink-rabbitmq
AMQP_URL=amqp://myink:myink@localhost:5672/
# 队列/交换名前缀（仅测试隔离用，生产留空与 Go/Python 端拓扑名一致）
QUEUE_PREFIX=
# VIP 优先级：JWT tier=vip 的消息 priority 属性（主队列 x-max-priority=10）
PRIORITY_VIP=9
PRIORITY_NORMAL=0

# 阶段 2 三层闸门配额（§13）。**0 = 不限**，章节数与成本三个上限默认关闭：
# 模型 Key 是用户自己的，写多少章由用户付费，部署方没有理由设卡。想给自己部署设限就填正数。
#   QUOTA_DAILY_CHAPTERS       每用户每日总章节数
#   BOOK_QUOTA_DAILY_CHAPTERS  每书每日章节数
#   DAILY_BUDGET_YUAN          全局日成本预算（¥）——注意是**全体用户共用一个桶**，
#                              开启后一个人写满就拦下所有人；要限流请优先用上面两个每用户项
QUOTA_DAILY_CHAPTERS=0
BOOK_QUOTA_DAILY_CHAPTERS=0
# 每天最多新建几本不同书：防刷建书，与 API Key 无关，默认保留生效。
BOOKS_PER_DAY=10
DAILY_BUDGET_YUAN=0

# 部署方内置模型密钥 + 新人终身免费额度。三项（KEY / BASE_URL / NAME）**全填才生效**，
# 任一为空即回落现状：用户没配自己的 key 就是「请先在环境配置里添加模型连接」。
# 内置密钥只对「一个自备连接都没有」的账号生效（凭据层与记账层共用这一条判据），
# role=admin 永久豁免。密钥是进程配置里的明文，从不写入 users.environment，
# 所以 GET /environment 结构上不会把它吐给前端。用户可挑的模型写死在 NAME 这一项。
#   **填了 KEY 就必须把 DAILY_BUDGET_YUAN 设成正数**（prod 下漏配直接拒绝启动）：
#   从此写多少章不再是用户付费，而 rate:cost 是全体用户共用的日成本桶。
# 终身额度，不重置（0 = 不限）：平台密钥免费写几个短篇 / 建几本长篇。
# 每本免费长篇累计能用平台密钥写多少章（0 = 不限，闸门连计数都不做）。
PLATFORM_MODEL_API_KEY=
PLATFORM_MODEL_BASE_URL=
PLATFORM_MODEL_NAME=
# openai（OpenAI 兼容 /v1/chat/completions）或 anthropic
PLATFORM_MODEL_PROTOCOL=openai
PLATFORM_SHORT_QUOTA=10
PLATFORM_LONG_QUOTA=3
PLATFORM_CHAPTERS_PER_BOOK=30

# 建书对话/账号文风提取：每账号同时 1 次、每天最多 60 次模型操作（失败也计次）。
# 同一 DAILY_BUDGET_YUAN 成本桶先预留，已知用量返回后结算；模型最多 4 次尝试。
# 已知模型用连接单价/内置估价与输入字节+输出上限预留；未知单价每次尝试预留下值。
# 无用量、失败/崩溃保留预留；并非供应商账单硬上限，自定义单价请按实际供应商填写。
ACCOUNT_MODEL_CALLS_DAILY=60
# 至少 600 秒，默认 900 秒；崩溃后自动释放，长于常规 4×120 秒模型重试。
ACCOUNT_MODEL_LEASE_SECONDS=900
ACCOUNT_MODEL_UNKNOWN_COST_YUAN=0.05

# 阶段 3：JWT 身份断言（§14.1 ③，替换 X-Myink-User 占位）。
# HS256 签名密钥：签发与验签都在 myink-api（config.py / auth.py），单一进程内闭环。
# 所有环境都必须显式配置至少 32 字节的强随机密钥，否则注册/登录拒绝服务。
# 已有模型密钥且 MODEL_CREDENTIAL_KEY 为空时，更换 JWT_SECRET 前先将旧有效 JWT_SECRET
# 固定到 MODEL_CREDENTIAL_KEY，保留旧密文解密能力。详见 docs/AUTH.md；不要覆盖已有 .env。
# 另：邀请码只存 HMAC(JWT_SECRET, 码面) 摘要，换密钥会让库中所有未用尽的邀请码失效。
# 换用强随机值：openssl rand -base64 48
JWT_SECRET=

# 进程内令牌桶（粗粒度 DoS 盾，非业务配额；真正的配额是上面的三层闸门）：
# 每秒补充 token 数 / 桶容量。全局一个桶，在 myink-api 进程内——SSE 与其余路由同源，
# 不再有「两个进程各一份桶、限额相加」那回事。
RATE_PER_SEC=20
RATE_BURST=40

# 客户端 IP：边缘（caddy/Caddyfile）用 `header_up X-Myink-Client-IP {http.request.remote.host}`
# 覆盖写入，Python 只认这个头（读不到才回落到直连对端地址）。header_up 是「设置」不是「追加」，
# 客户端自带的同名头会被抹掉，所以伪造这个头不能自选限流桶。
# ⚠️ 将来若在 Caddy 前面再挂一层（CDN / 云 LB），那一层必须配 Caddy 全局 `trusted_proxies`
# 并把这里换成 `{client_ip}`；否则拿到的全是那层的 IP，所有用户塌进同一个桶——一个人刷就
# 锁死所有人登录（0a7d520 修掉的正是这个故障）。不要改成在 Python 侧加环境变量来绕。

# 边缘层站点地址（compose 拿它插值给 Caddy，见 caddy/Caddyfile 顶部）。
# http://localhost = 本地纯 HTTP（默认） / localhost = 本地自签 HTTPS / 域名（不带协议）= 生产 ACME 自动签发续期。
# 只有这一处决定 Caddy 认哪个 Host：保持默认时换成域名访问会拿到 200 空页（不报错），
# 手机上打开就是一片空白而不是报错页，所以公网务必填域名本身（不要带 https://）。
# 另外这一行只在本地跑 `npm run dev` 时牵动 web/vite.config.ts 的 dev proxy 目标；
# 生产是 Caddy 直接托管前端构建产物，同源，用不到那个代理。切流步骤见 docs/DEPLOY.md。
SITE_ADDRESS=http://localhost

# 裸 IP 上 HTTPS（备案批下来之前的过渡形态）才需要的两项，其余场景保持默认即可。
# 上面的 SITE_ADDRESS 要同时填成 https://<公网 IP>。域名场景两项都别改——
# 套上短效证书会把域名的 90 天证书压成 6 天。原理与回退见 docs/DEPLOY.md。
#   CADDY_SITE_TLS     选站点块导入的 TLS 片段；tls-public-ip.caddyfile = 显式指定 ACME 签发者 + shortlived
#   CADDY_DEFAULT_SNI  客户端不发 SNI 时的兜底证书选择，填公网 IP 字面量
CADDY_SITE_TLS=tls-auto.caddyfile
CADDY_DEFAULT_SNI=localhost

# 扫榜表单初值（用户可在前端「环境配置」覆盖；未保存时才读这里）。
# 榜单只作建书前灵感、不进记忆层。RANKINGS_CACHE_TTL 仍只走进程配置。
RANKINGS_ENABLED=1
RANKINGS_TIMEOUT=10
RANKINGS_LIMIT=10
RANKINGS_CACHE_TTL=3600

# 章节提示词估算预算（中文字符启发式，非精确 tokenizer 计数）。
# 组装预留 1000 给工具描述/纠错；完整章节请求（含工具结果）也会检查。
RECALL_TOKEN_BUDGET=12000

# 完整模型请求预算（正文/硬约束/提示词/工具），与召回记忆预算分开
REQUEST_TOKEN_BUDGET=64000
