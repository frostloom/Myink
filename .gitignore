# 密钥与配置（plan §17.2：密钥不进代码库）
.env
.local/
*.env
!*.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 测试/临时
.coverage
htmlcov/

# 本地构建缓存（体积数百 MB）
.tmp/go-cache/

# 本地数据
*.db
*.sqlite3
# 用户反馈附件默认落盘目录（dev 下在仓库里，不进版本库）
.data/

# 外部参考项目（仅参考不调用，不进版本库）
inkos/

# 内部工作文档（只留本地，不进公开仓库）
/REMOTE-SERVER.local.md
CLAUDE.md
plan.md
inte*view.md

# 本地分支工作区
/worktrees/

# Pi 实验留在本机的状态和检查点，含凭证，不进版本库
/myink-pi/

# Captured public release assets are build inputs, not source files.
caddy/retained-assets/*
!caddy/retained-assets/.gitkeep
