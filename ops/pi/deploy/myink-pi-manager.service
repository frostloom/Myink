[Unit]
Description=Myink Pi finite manager
After=network-online.target docker.service
Wants=network-online.target
Requisite=docker.service
ConditionPathExists=/home/ubuntu/myink-pi-managed/state/actual-manager.sqlite
ConditionPathExists=/home/ubuntu/myink-pi-managed/state/ledger.sqlite

[Service]
Type=exec
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/home/ubuntu/myink-pi-managed
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/home/ubuntu/myink-pi-managed/tmp
Environment=DOCKER_CONFIG=/home/ubuntu/myink-pi-managed/state/docker
EnvironmentFile=/home/ubuntu/myink-pi-managed/config/service.env
ExecStart=/usr/bin/flock --nonblock --no-fork /home/ubuntu/myink-pi-managed/control/maintenance.lock /usr/bin/python3 -m ops.pi.manager --state /home/ubuntu/myink-pi-managed/state/actual-manager.sqlite --billing /home/ubuntu/myink-pi-managed/state/ledger.sqlite run --max-tasks 1 --seconds 2100 --inbox /home/ubuntu/myink-pi-managed/inbox --idle-seconds 0
Restart=no
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=300
RuntimeMaxSec=2400
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/home/ubuntu/myink-pi-managed/releases /home/ubuntu/myink-pi-managed/config /home/ubuntu/myink-pi-managed/history
ReadWritePaths=/home/ubuntu/myink-pi-managed/state /home/ubuntu/myink-pi-managed/jobs /home/ubuntu/myink-pi-managed/inbox /home/ubuntu/myink-pi-managed/tmp /home/ubuntu/myink-pi-managed/control
MemoryMax=512M
TasksMax=96
CPUQuota=100%
LimitNOFILE=512
StandardOutput=journal
StandardError=journal
SyslogIdentifier=myink-pi-manager
