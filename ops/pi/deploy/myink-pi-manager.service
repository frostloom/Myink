[Unit]
Description=Myink Pi finite manager
After=network-online.target docker.service
Wants=network-online.target
Requisite=docker.service
ConditionPathExists=/home/ubuntu/myink-pi-managed/state/actual-manager.sqlite
ConditionPathExists=/home/ubuntu/myink-pi-managed/state/ledger.sqlite
ConditionPathExists=/home/ubuntu/myink-pi-managed/config/closed-manager.env
ConditionPathExists=/home/ubuntu/myink-pi-managed/config/manager-host.json

[Service]
Type=exec
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/home/ubuntu/myink-pi-managed
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/home/ubuntu/myink-pi-managed/tmp
Environment=DOCKER_CONFIG=/home/ubuntu/myink-pi-managed/state/docker
EnvironmentFile=/home/ubuntu/myink-pi-managed/config/closed-manager.env
ExecStart=/usr/bin/flock --nonblock --no-fork /home/ubuntu/myink-pi-managed/control/maintenance.lock /usr/bin/python3 -I -S -B ${PI_MANAGER_ENTRYPOINT} --component manager --config /home/ubuntu/myink-pi-managed/config/manager-host.json --config-sha256 ${PI_MANAGER_CONFIG_SHA256}
Restart=no
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=300
RuntimeMaxSec=2400
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/home/ubuntu/myink-pi-managed/releases /home/ubuntu/myink-pi-managed/config /home/ubuntu/myink-pi-managed/history
ReadWritePaths=/home/ubuntu/myink-pi-managed/state /home/ubuntu/myink-pi-managed/jobs /home/ubuntu/myink-pi-managed/inbox /home/ubuntu/myink-pi-managed/tmp /home/ubuntu/myink-pi-managed/control /home/ubuntu/myink-pi-managed/handoffs /home/ubuntu/myink-pi-managed/reproductions /home/ubuntu/myink-pi-managed/reviews /home/ubuntu/myink-pi-managed/audit/state /home/ubuntu/myink-pi-managed/audit/export
MemoryMax=512M
TasksMax=96
CPUQuota=100%
LimitNOFILE=512
StandardOutput=journal
StandardError=journal
SyslogIdentifier=myink-pi-manager
