      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaa01",
      "name": "生成大纲草稿",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        0
