      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4000,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json).sort((a, b) => a.chapter_seq - b.chapter_seq);\nconst title = $('配置').first().json.title;\nconst body = rows.map((c) => '## 第' + c.chapter_seq + '章 ' + (c.title || '') + '\\n\\n' + (c.content || '')).join('\\n\\n');\nconst words = rows.reduce((n, c) => n + (Number(c.word_count) || 0), 0);\nreturn [{ json: { title, manuscript: '# ' + title + '\\n\\n' + body, chapters: rows.length, words } }];"
      },
