    {
      "parameters": {
        "jsCode": "const draft = $('生成设定草稿').first().json.draft || {};\nconst premise = $('配置').first().json.premise;\nconst arr = (v) => Array.isArray(v) ? v : [];\nconst constraints = arr(draft.hard_constraints).filter(Boolean);\nreturn [{ json: { world_rules: (draft.world_rules && typeof draft.world_rules === 'object') ? draft.world_rules : {}, hard_constraints: constraints.length ? constraints : [premise], characters: arr(draft.characters), forces: arr(draft.forces), locations: arr(draft.locations) } }];"
      },
