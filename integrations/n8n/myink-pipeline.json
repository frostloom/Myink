    {
      "parameters": {
        "jsCode": "const cfg = $('配置').first().json;\nconst count = Math.min(1000, Math.max(50, Number(cfg.chapterCount) || 50));\nconst raw = $('生成大纲草稿').first().json.outline || {};\nconst valid = (o) => {\n  if (!o || typeof o !== 'object') return false;\n  const n = Number(o.chapter_count);\n  const vs = o.volumes;\n  if (!String(o.objective || '').trim() || !Array.isArray(vs) || !vs.length || !(n >= 50 && n <= 1000)) return false;\n  let next = 1;\n  for (const v of vs) {\n    const s = Number(v.chapter_start), e = Number(v.chapter_end);\n    if (!String(v.goal || '').trim() || s !== next || e < s || e > n) return false;\n    next = e + 1;\n  }\n  return next === n + 1;\n};\nif (valid(raw)) return [{ json: raw }];\nreturn [{ json: { objective: cfg.premise, premise: cfg.premise, chapter_count: count, storyline: cfg.storyline, volumes: [{ volume_seq: 1, title: '第一卷', goal: cfg.premise, chapter_start: 1, chapter_end: count }] } }];"
      },
